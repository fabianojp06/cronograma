# Banco PostgreSQL (Railway — projeto 28445ef3-95ee-44bd-bfba-b5af383d8057)
# O serviço "Postgres" JÁ está provisionado no ambiente `production` do Railway.
# Pegue a connection string com a CLI do Railway (nunca commite o valor real):
#
#   railway link -p 28445ef3-95ee-44bd-bfba-b5af383d8057 -e production -s Postgres
#   railway variables -s Postgres --kv
#
# - DATABASE_URL (postgres.railway.internal:5432) só funciona de dentro do Railway.
# - Para acesso externo (sua máquina e a Vercel), use o TCP proxy público do serviço:
#   host = RAILWAY_TCP_PROXY_DOMAIN, porta = RAILWAY_TCP_PROXY_PORT, base "railway".
DATABASE_URL="postgresql://postgres:SENHA@HOST.proxy.rlwy.net:PORTA/railway"

# Alternativa para desenvolvimento 100% offline, via Docker:
#
#   docker run -d --name cronograma-pg \
#     -e POSTGRES_USER=cronograma -e POSTGRES_PASSWORD=cronograma \
#     -e POSTGRES_DB=cronograma -p 55432:5432 postgres:16
#
#   DATABASE_URL="postgresql://cronograma:cronograma@localhost:55432/cronograma?schema=public"
#
# Em qualquer um dos dois:
#   npm run db:deploy   # aplica as migrations versionadas
#   npm run db:seed     # popula 3 projetos de exemplo com 5 ações cada

# Homologação (só na Vercel, só para a branch `homologacao`): host:porta do banco
# dela, sem usuário nem senha. O build da homologação só migra se a DATABASE_URL
# daquela branch apontar para este host.
# HOMOLOGACAO_BANCO_HOST="host.exemplo:12345"

# Autenticação — Clerk (instância ins_3JTS4qDnU1wKm8mPloItwq6KxYJ)
# Copiar de https://dashboard.clerk.com -> API Keys. NUNCA commitar o .env real.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"

# Rotas de autenticação em português (usadas pelo ClerkProvider e pelo proxy)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/entrar"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/cadastrar"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Login social via Microsoft/Outlook (Azure AD OAuth) é configurado no dashboard do
# Clerk (User & Authentication -> SSO Connections -> Microsoft), não por variável de
# ambiente. Em desenvolvimento o Clerk usa credenciais compartilhadas; em produção é
# obrigatório cadastrar Client ID/Secret de um app registrado no Azure AD.

# ---------------------------------------------------------------------------
# Deploy na Vercel (projeto prj_HxI1VBYwefOAGBqyJXvEOCBAkHPO / cronograma-lktu)
# Todas as variáveis acima (menos as de Docker) precisam existir também em
# Settings -> Environment Variables do projeto na Vercel, nos ambientes
# Production e Preview. O DATABASE_URL lá deve ser o do TCP proxy público.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# E-mail — aviso ao responsável por uma ação (Resend, https://resend.com)
# Só é enviado quando VERCEL_ENV=production: o preview usa o mesmo banco e
# avisaria colaboradores reais. Cadastre na Vercel SÓ no ambiente Production.
# Sem a chave, nada é enviado e a tela diz isso; a ação é salva normalmente.
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxx"
# Remetente num domínio verificado no Resend. Sem ele, usa onboarding@resend.dev,
# que só entrega para o e-mail do dono da conta Resend.
EMAIL_REMETENTE="Cronograma CTCEA <cronograma@ctcea.org.br>"
# Opcional: endereço público do sistema para o link do e-mail. Sem ela, usa o
# domínio de produção que a Vercel informa (VERCEL_PROJECT_PRODUCTION_URL).
# APP_URL="https://cronograma.ctcea.org.br"
