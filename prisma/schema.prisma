// Schema do Sistema Cronograma CTCEA — nomes de domínio em português (ver CLAUDE.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusAcao {
  NAO_INICIADO
  EM_CURSO_25
  EM_CURSO_50
  EM_CURSO_75
  CONCLUIDO
}

model Projeto {
  id             String   @id @default(cuid())
  referencia     String? // ex: "CRO-DEP-2026-001"
  nome           String
  equipe         String? // ex: STI, GIA, GRH
  natureza       String? // ex: Desenvolvimento, Infraestrutura, Iniciativa
  categoria      String?
  /// Nome do responsável, em texto: é o que os relatórios agrupam. Quando há
  /// `liderId`, é a cópia do nome do líder escolhido na lista.
  responsavel    String?
  /// Líder do projeto, escolhido na lista de colaboradores (quem decide as
  /// liberações de início). Nulo: vale o nome em `responsavel`, casado pelo nome.
  liderId        String?
  lider          Colaborador? @relation("LiderDoProjeto", fields: [liderId], references: [id], onDelete: SetNull)
  apoio          String?
  setorEnvolvido String?
  comentario     String?
  prioridade     Int?
  ativo          Boolean  @default(true) // exclusão lógica — nunca DELETE físico
  /// Quando e por quem foi excluído por último (`userId` do Clerk); nulo nos projetos
  /// excluídos antes desta coluna existir.
  excluidoEm     DateTime?
  excluidoPor    String?
  /// Quando e por quem foi restaurado da lixeira pela última vez.
  restauradoEm   DateTime?
  restauradoPor  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  acoes     Acao[]
  avaliacao AvaliacaoProjeto?
  wins      Win[]
  riscos    RiscoProjeto[]

  @@index([ativo])
  @@index([equipe])
  @@index([liderId])
}

model Acao {
  id        String     @id @default(cuid())
  projetoId String
  projeto   Projeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  numero    Int // sequencial dentro do projeto
  descricao String
  status    StatusAcao @default(NAO_INICIADO)

  previstoInicio   DateTime?
  previstoTermino  DateTime?
  realizadoInicio  DateTime?
  realizadoTermino DateTime?
  duracaoDiasUteis Int? // calculado, não editável diretamente

  /// Quem responde pela ação. Opcional: as ações importadas da planilha não
  /// têm responsável individual. Desligar a pessoa não apaga a ação — o
  /// colaborador é desativado, nunca excluído, mas o SetNull cobre o caso.
  responsavelId String?
  responsavel   Colaborador? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  historico   HistoricoAlteracao[]
  wins        Win[]
  comentarios ComentarioAcao[]
  /// Ações que precisam terminar antes desta começar.
  dependeDe   DependenciaAcao[] @relation("DependenteDe")
  /// Ações que esperam por esta.
  predecessoraDe DependenciaAcao[] @relation("Predecessora")
  liberacoes  LiberacaoAcao[]
  riscos      RiscoProjeto[]
  links       LinkAcao[]

  @@unique([projetoId, numero])
  @@index([projetoId])
  @@index([responsavelId])
}

model HistoricoAlteracao {
  id          String   @id @default(cuid())
  acaoId      String
  acao        Acao     @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  campo       String // ex: "status", "previstoTermino"
  valorAntigo String?
  valorNovo   String?
  alteradoEm  DateTime @default(now())
  alteradoPor String? // login/nome de quem alterou, se aplicável
  /// Só nas mudanças de data PREVISTA: por que o plano mudou (código de `motivo-replanejamento.ts`).
  motivo        String?
  motivoDetalhe String?

  @@index([acaoId, alteradoEm])
}

/// Comentário livre numa Ação — a coluna de comentário da planilha, mas com
/// autor e momento. Só se acrescenta: não há edição, para a conversa não ser
/// reescrita depois. Quem escreveu pode apagar o seu (e o administrador, o de
/// qualquer um). `autor` é o `userId` do Clerk, como em `HistoricoAlteracao`;
/// o nome é resolvido pelo colaborador vinculado na hora de mostrar.
model ComentarioAcao {
  id       String   @id @default(cuid())
  acaoId   String
  acao     Acao     @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  texto    String
  autor    String
  criadoEm DateTime @default(now())

  notificacoes Notificacao[]

  @@index([acaoId, criadoEm])
}

/// Avaliação de um Projeto na Matriz de Priorização (Benefício x Esforço
/// ponderado por GUT). Relação 1:1 opcional — projeto sem avaliação
/// simplesmente não tem registro aqui, e é isso que significa "não avaliado".
/// A planilha original precisava de 45 linhas zeradas por ser planilha.
///
/// As notas dos 10 critérios usam a escala 0/3/6/9 da planilha; G, U e T usam
/// a escala GUT clássica de 1 a 5. Os totais (benefício, esforço, GUT e
/// prioridade) NÃO são colunas: são derivados das notas e dos pesos vigentes,
/// em `matriz-calculo.ts`. Guardá-los daria dois valores para a mesma verdade,
/// e eles mudariam sozinhos ao ajustar um peso.
model AvaliacaoProjeto {
  id        String  @id @default(cuid())
  projetoId String  @unique
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  // Benefício — escala 0/3/6/9
  beneficioCompromissos     Int @default(0)
  beneficioValorTecnologico Int @default(0)
  beneficioClima            Int @default(0)
  beneficioGovernanca       Int @default(0)
  beneficioEficiencia       Int @default(0)

  // Esforço — escala 0/3/6/9
  esforcoOrcamento        Int @default(0)
  esforcoDuracao          Int @default(0)
  esforcoCapacidadeEquipe Int @default(0)
  esforcoResistencia      Int @default(0)
  esforcoComplexidade     Int @default(0)

  // GUT — escala 1 a 5
  gravidade Int @default(1)
  urgencia  Int @default(1)
  tendencia Int @default(1)

  observacao  String?
  avaliadoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Peso de um critério da matriz, em pontos percentuais inteiros (20 = 20%).
///
/// Inteiro e não decimal de propósito: a regra é "a soma do grupo dá 100",
/// e com ponto flutuante essa conferência falharia por arredondamento.
/// Uma linha por critério; critério sem linha usa o peso padrão do catálogo,
/// então a tabela vazia equivale à configuração original da planilha.
model PesoCriterio {
  criterio  String   @id
  peso      Int
  updatedAt DateTime @updatedAt
}

/// Status de um WIN numa semana. A planilha usa FEITO / NÃO FEITO / EM
/// ANDAMENTO e deixa a célula **vazia** com frequência — vazio vira PENDENTE
/// aqui, para que "ninguém preencheu" seja um estado nomeado e não um buraco.
/// O que aconteceu com uma aparição do WIN numa semana.
enum DesfechoWin {
  /// Está no card desta semana, ocupando uma das três posições.
  NO_CARD
  /// Virou item do plano de ação pela regra das 3 semanas.
  PROMOVIDO
  /// Terminou aqui — concluído ou abandonado, conforme o `status`.
  ENCERRADO
}

enum StatusWin {
  PENDENTE
  EM_ANDAMENTO
  FEITO
  NAO_FEITO
}

/// Pessoa dona de um Card WIN.
///
/// `nome` é a mesma grafia usada em `Projeto.responsavel`: é ele que será
/// gravado lá quando um WIN virar item do plano de ação, e é o que mantém o
/// relatório "por responsável" do dashboard somando certo. Por isso é único —
/// a lista fechada existe justamente para "Fabiano Garcia" e "Fabiano" não
/// virarem duas pessoas.
///
/// `clerkUserId` é opcional de propósito: um colaborador pode ter card antes
/// de ter conta, e a aba Referências da planilha já listava quatro pessoas.
model Colaborador {
  id          String  @id @default(cuid())
  nome        String  @unique
  clerkUserId String? @unique
  /// Área da GIA — AGP, APD ou ACT. Serve de padrão ao abrir um card novo.
  area        String?
  /// E-mail para notificações. Semeado pelo Clerk no vínculo da conta e
  /// editável em /colaboradores — quem veio da planilha nunca fez login.
  email       String?
  ativo       Boolean @default(true)
  /// Pode excluir projeto, editar os pesos da matriz e gerenciar colaboradores.
  /// Enquanto NINGUÉM for administrador, todos podem (o comportamento de antes
  /// desta coluna) — assim o sistema não nasce trancado. Ver `administracao.ts`.
  administrador Boolean @default(false)
  /// Perfil Leitor: vê tudo e exporta, mas não grava nada. O padrão (false) é o
  /// Colaborador, que edita. Administrador nunca é leitor. Ver `administracao.ts`.
  somenteLeitura Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards CardSemanal[]
  wins  Win[]
  acoes Acao[]
  notificacoes Notificacao[]
  /// Projetos de que é o líder (escolhido na lista, em `Projeto.liderId`).
  projetosLiderados Projeto[] @relation("LiderDoProjeto")
  riscosSobResponsabilidade RiscoProjeto[]

  @@index([ativo])
}

/// O Card WIN de um colaborador numa semana — o cabeçalho da aba da planilha.
///
/// Não guarda o bloco "WINs da semana anterior": ele é **derivado** dos
/// registros da semana anterior. Era a duplicação manual desse bloco que fazia
/// a planilha divergir de si mesma (a aba S37 repetia o bloco da S36 em vez de
/// trazer os WINs atuais dela).
model CardSemanal {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  /// Ano e semana do calendário da CTCEA (ver `semana-ctcea.ts`) — NÃO é ISO.
  ano    Int
  semana Int

  area         String?
  atividade    String?
  alertaRiscos String?
  pedidoAjuda  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registros WinSemana[]

  @@unique([colaboradorId, ano, semana])
  @@index([ano, semana])
}

/// O compromisso em si, com identidade que **atravessa semanas**.
///
/// É esta identidade que permite contar repetições sem comparar texto. Na
/// planilha o mesmo item aparecia como "… relatórios orçamentários", depois
/// "… relatórios orçamentários ()" e depois "… relatórios orçamentários () -
/// SGO": qualquer contagem por string erraria.
model Win {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  descricao String
  suporte   String?

  /// Aparições que existiram fora do sistema, semeadas na importação da
  /// planilha. Sem isto, um WIN que já vinha de três semanas recomeçaria do
  /// zero e escaparia da promoção justamente no momento em que ela é devida.
  aparicoesAnteriores Int @default(0)

  /// Preenchidos quando o WIN é promovido ao plano de ação. Exatamente um dos
  /// dois fica preenchido — projeto novo ou ação dentro de projeto existente.
  promovidoEm DateTime?
  projetoId   String?
  projeto     Projeto?  @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  acaoId      String?
  acao        Acao?     @relation(fields: [acaoId], references: [id], onDelete: SetNull)

  /// Encerrado sem promoção (concluído ou abandonado).
  encerradoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registros WinSemana[]

  @@index([colaboradorId])
  @@index([promovidoEm])
}

/// A aparição de um WIN numa semana: prazo, status e posição no card.
model WinSemana {
  id     String      @id @default(cuid())
  winId  String
  win    Win         @relation(fields: [winId], references: [id], onDelete: Cascade)
  cardId String
  card   CardSemanal @relation(fields: [cardId], references: [id], onDelete: Cascade)

  /// 1 a 3 — o limite do método, garantido também no banco pela CHECK
  /// `WinSemana_ordem_entre_1_e_3`.
  ordem  Int
  /// O que aconteceu com esta APARIÇÃO — e não com o WIN.
  ///
  /// Mora aqui, e não em `Win`, porque um WIN promovido na semana 39 continua
  /// tendo acontecido nas semanas 37 e 38: ler o desfecho de `Win.promovidoEm`
  /// tiraria o WIN do denominador de todas as semanas anteriores.
  desfecho DesfechoWin @default(NO_CARD)
  prazo  DateTime?
  status StatusWin @default(PENDENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A unicidade de `[cardId, ordem]` é **parcial** e vive em SQL, na migration
  /// `wins_desfecho_da_aparicao`: vale só onde `desfecho = NO_CARD`. É o que
  /// libera a vaga quando um WIN sai do card sem apagar o histórico dele. O
  /// Prisma não expressa índice parcial — mesmo caminho da CHECK de `ordem`.
  /// O mesmo WIN não aparece duas vezes no mesmo card.
  @@unique([cardId, winId])
  @@index([winId])
  @@index([desfecho])
}

/// Falhas do sistema, guardadas para consulta pelo administrador.
///
/// Existe porque o log de execução da Vercel (plano Hobby) guarda só 1 hora: um
/// erro de sexta à noite já terá sumido na segunda. Só produção grava, e o que
/// passa de 30 dias é apagado.
model RegistroErro {
  id       String   @id @default(cuid())
  criadoEm DateTime @default(now())
  /// De onde veio: "Falha ao salvar WIN", "Resend recusou o e-mail", "Erro em /dashboards".
  origem   String
  mensagem String
  /// Pilha ou corpo da resposta, truncado.
  detalhe  String?
  rota     String?
  /// Identificador que o Next mostra ao usuário na tela de erro.
  digest   String?

  @@index([criadoEm])
}

/// Resultado de cada execução de uma tarefa agendada (hoje, o aviso semanal de
/// atraso). A Vercel Hobby guarda o log por 1 hora, então "o cron rodou? quantos
/// e-mails saíram?" não teria resposta na segunda à tarde. Poda por quem grava.
model ExecucaoCron {
  id         String   @id @default(cuid())
  nome       String
  executadoEm DateTime @default(now())
  ok         Boolean
  /// Resumo em texto: contagens em caso de sucesso, mensagem em caso de falha.
  resumo     String

  @@index([nome, executadoEm])
}

/// Aviso, dentro do sistema, de que alguém comentou uma ação que diz respeito à
/// pessoa: ela foi marcada, ou responde pela ação. Nasce na mesma gravação do
/// comentário e some com ele (cascata). Não há e-mail: o sino do cabeçalho conta
/// as não lidas. Lida há mais de 30 dias é apagada por quem comenta.
model Notificacao {
  id            String         @id @default(cuid())
  destinatarioId String
  destinatario  Colaborador    @relation(fields: [destinatarioId], references: [id], onDelete: Cascade)
  /// Aviso de comentário: preenchido; aviso de liberação de início: nulo.
  comentarioId  String?
  comentario    ComentarioAcao? @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  /// Aviso de liberação de início (pedido ou decisão): preenchido; senão, nulo.
  liberacaoId   String?
  liberacao     LiberacaoAcao? @relation(fields: [liberacaoId], references: [id], onDelete: Cascade)
  /// Aviso do resumo semanal (motivo RESUMO_SEMANAL): preenchido; senão, nulo.
  resumoId      String?
  resumo        ResumoSemanal? @relation(fields: [resumoId], references: [id], onDelete: Cascade)
  /// Aviso de risco/bloqueio atribuído (motivo RISCO_RESPONSAVEL): preenchido; senão, nulo.
  riscoId       String?
  risco         RiscoProjeto?  @relation(fields: [riscoId], references: [id], onDelete: Cascade)
  /// MARCADO (a pessoa foi escolhida em "Avisar") ou RESPONSAVEL (responde pela ação);
  /// LIBERACAO_PEDIDA, LIBERACAO_APROVADA ou LIBERACAO_RECUSADA nos avisos de liberação.
  motivo        String
  lida          Boolean        @default(false)
  criadoEm      DateTime       @default(now())

  @@unique([destinatarioId, comentarioId])
  @@unique([destinatarioId, resumoId])
  @@index([destinatarioId, lida, criadoEm])
  @@index([liberacaoId])
  @@index([resumoId])
  @@index([riscoId])
}

/// Resumo semanal para quem administra: uma FOTO do que concluiu, atrasou e
/// vence nos próximos 7 dias, por equipe, tirada na segunda-feira (8h de
/// Brasília). `semana` é a data da segunda-feira, `aaaa-mm-dd`, e é única: o
/// resumo de uma semana nasce uma vez só, não importa quem o provoque.
model ResumoSemanal {
  id       String   @id @default(cuid())
  semana   String   @unique
  geradoEm DateTime @default(now())
  /// O conteúdo exato (ver `resumo-semanal.ts`): o que o gestor viu não muda depois.
  conteudo Json

  notificacoes Notificacao[]
}

/// "B só começa quando A terminar": `acaoId` (B) depende de `predecessoraId` (A),
/// sempre do mesmo projeto. Sem ciclos — a regra mora em `dependencia-acao.ts`.
model DependenciaAcao {
  id             String   @id @default(cuid())
  acaoId         String
  acao           Acao     @relation("DependenteDe", fields: [acaoId], references: [id], onDelete: Cascade)
  predecessoraId String
  predecessora   Acao     @relation("Predecessora", fields: [predecessoraId], references: [id], onDelete: Cascade)
  /// `userId` do Clerk de quem criou o vínculo.
  criadoPor      String?
  criadoEm       DateTime @default(now())

  @@unique([acaoId, predecessoraId])
  @@index([predecessoraId])
}

/// Pedido para iniciar uma ação ANTES de as predecessoras terminarem, decidido
/// pelo líder do projeto (ou um administrador). Aprovada, a ação fica liberada.
model LiberacaoAcao {
  id           String    @id @default(cuid())
  acaoId       String
  acao         Acao      @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  /// `userId` do Clerk de quem pediu (ou do líder, quando liberou direto).
  solicitante  String
  motivo       String
  /// PENDENTE, APROVADA ou RECUSADA.
  status       String    @default("PENDENTE")
  /// `userId` do Clerk de quem decidiu.
  decididoPor  String?
  justificativa String?
  criadoEm     DateTime  @default(now())
  decididoEm   DateTime?

  notificacoes Notificacao[]

  @@index([acaoId, status])
}

/// Modelo de projeto: um esqueleto reutilizável (ciclos anuais, rotinas da
/// STI/GIA/GRH). Guarda os campos de classificação do projeto e a lista de ações
/// com datas RELATIVAS — quando alguém cria um projeto a partir dele, informa a
/// data de início e as datas das ações são calculadas em dias úteis. Responsáveis
/// e status não vão para o modelo: pessoas e andamento são do projeto, não do molde.
model ModeloProjeto {
  id             String   @id @default(cuid())
  nome           String   @unique
  descricao      String?
  equipe         String?
  natureza       String?
  categoria      String?
  apoio          String?
  setorEnvolvido String?
  /// `userId` do Clerk de quem salvou: só ele (ou um administrador) exclui.
  criadoPor      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  acoes ModeloAcao[]
}

model ModeloAcao {
  id        String       @id @default(cuid())
  modeloId  String
  modelo    ModeloProjeto @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  ordem     Int
  descricao String
  /// Dias úteis entre o início do projeto e o início desta ação (0 = no mesmo dia).
  /// Nulo = a ação não tinha data prevista no projeto de origem.
  inicioDiasUteis  Int?
  /// Duração em dias úteis (as duas pontas contam, como `diasUteisEntre`).
  duracaoDiasUteis Int?

  @@unique([modeloId, ordem])
}

/// Risco (pode acontecer) ou bloqueio (já está travando) de um projeto: o campo
/// estruturado do que o Card WIN chama de "alerta de riscos". Strings, como o
/// resto do sistema: `tipo` RISCO|BLOQUEIO, `impacto` BAIXO|MEDIO|ALTO e
/// `status` ABERTO|EM_TRATAMENTO|RESOLVIDO|ACONTECEU (ver `risco-projeto.ts`).
model RiscoProjeto {
  id            String       @id @default(cuid())
  projetoId     String
  projeto       Projeto      @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  /// A ação que ele afeta, quando houver.
  acaoId        String?
  acao          Acao?        @relation(fields: [acaoId], references: [id], onDelete: SetNull)
  tipo          String
  titulo        String
  descricao     String?
  impacto       String
  status        String       @default("ABERTO")
  responsavelId String?
  responsavel   Colaborador? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  /// Até quando tratar (data de negócio, meia-noite UTC).
  prazo         DateTime?
  plano         String?
  /// `userId` do Clerk de quem registrou: só ele (ou um administrador) exclui.
  criadoPor     String
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt
  /// Quando saiu de aberto (resolvido ou "aconteceu"); nulo enquanto aberto.
  resolvidoEm   DateTime?

  historico    RiscoHistorico[]
  notificacoes Notificacao[]

  @@index([projetoId, status])
  @@index([acaoId])
  @@index([responsavelId])
}

/// Trilha de mudanças de um risco (status, impacto, tipo, responsável e prazo).
model RiscoHistorico {
  id          String       @id @default(cuid())
  riscoId     String
  risco       RiscoProjeto @relation(fields: [riscoId], references: [id], onDelete: Cascade)
  campo       String
  valorAntigo String?
  valorNovo   String?
  alteradoEm  DateTime     @default(now())
  alteradoPor String?

  @@index([riscoId, alteradoEm])
}

/// Link de apoio de uma ação (ata, contrato, planilha...). Só o ENDEREÇO: o
/// arquivo mora onde a CTCEA já guarda, e quem pode abri-lo é decidido lá.
/// `tipo`: ATA|CONTRATO|PLANILHA|DOCUMENTO|OUTRO (ver `link-acao.ts`).
model LinkAcao {
  id           String   @id @default(cuid())
  acaoId       String
  acao         Acao     @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  titulo       String
  url          String
  tipo         String
  /// `userId` do Clerk de quem acrescentou.
  criadoPor    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([acaoId])
}
