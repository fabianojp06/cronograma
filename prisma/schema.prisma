// Schema do Sistema Cronograma CTCEA — nomes de domínio em português (ver CLAUDE.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusAcao {
  NAO_INICIADO
  EM_CURSO_25
  EM_CURSO_50
  EM_CURSO_75
  CONCLUIDO
}

model Projeto {
  id             String   @id @default(cuid())
  referencia     String? // ex: "CRO-DEP-2026-001"
  nome           String
  equipe         String? // ex: STI, GIA, GRH
  natureza       String? // ex: Desenvolvimento, Infraestrutura, Iniciativa
  categoria      String?
  responsavel    String?
  apoio          String?
  setorEnvolvido String?
  comentario     String?
  prioridade     Int?
  ativo          Boolean  @default(true) // exclusão lógica — nunca DELETE físico
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  acoes     Acao[]
  avaliacao AvaliacaoProjeto?
  wins      Win[]

  @@index([ativo])
  @@index([equipe])
}

model Acao {
  id        String     @id @default(cuid())
  projetoId String
  projeto   Projeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  numero    Int // sequencial dentro do projeto
  descricao String
  status    StatusAcao @default(NAO_INICIADO)

  previstoInicio   DateTime?
  previstoTermino  DateTime?
  realizadoInicio  DateTime?
  realizadoTermino DateTime?
  duracaoDiasUteis Int? // calculado, não editável diretamente

  /// Quem responde pela ação. Opcional: as ações importadas da planilha não
  /// têm responsável individual. Desligar a pessoa não apaga a ação — o
  /// colaborador é desativado, nunca excluído, mas o SetNull cobre o caso.
  responsavelId String?
  responsavel   Colaborador? @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  historico HistoricoAlteracao[]
  wins      Win[]

  @@unique([projetoId, numero])
  @@index([projetoId])
  @@index([responsavelId])
}

model HistoricoAlteracao {
  id          String   @id @default(cuid())
  acaoId      String
  acao        Acao     @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  campo       String // ex: "status", "previstoTermino"
  valorAntigo String?
  valorNovo   String?
  alteradoEm  DateTime @default(now())
  alteradoPor String? // login/nome de quem alterou, se aplicável

  @@index([acaoId, alteradoEm])
}

/// Avaliação de um Projeto na Matriz de Priorização (Benefício x Esforço
/// ponderado por GUT). Relação 1:1 opcional — projeto sem avaliação
/// simplesmente não tem registro aqui, e é isso que significa "não avaliado".
/// A planilha original precisava de 45 linhas zeradas por ser planilha.
///
/// As notas dos 10 critérios usam a escala 0/3/6/9 da planilha; G, U e T usam
/// a escala GUT clássica de 1 a 5. Os totais (benefício, esforço, GUT e
/// prioridade) NÃO são colunas: são derivados das notas e dos pesos vigentes,
/// em `matriz-calculo.ts`. Guardá-los daria dois valores para a mesma verdade,
/// e eles mudariam sozinhos ao ajustar um peso.
model AvaliacaoProjeto {
  id        String  @id @default(cuid())
  projetoId String  @unique
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  // Benefício — escala 0/3/6/9
  beneficioCompromissos     Int @default(0)
  beneficioValorTecnologico Int @default(0)
  beneficioClima            Int @default(0)
  beneficioGovernanca       Int @default(0)
  beneficioEficiencia       Int @default(0)

  // Esforço — escala 0/3/6/9
  esforcoOrcamento        Int @default(0)
  esforcoDuracao          Int @default(0)
  esforcoCapacidadeEquipe Int @default(0)
  esforcoResistencia      Int @default(0)
  esforcoComplexidade     Int @default(0)

  // GUT — escala 1 a 5
  gravidade Int @default(1)
  urgencia  Int @default(1)
  tendencia Int @default(1)

  observacao  String?
  avaliadoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Peso de um critério da matriz, em pontos percentuais inteiros (20 = 20%).
///
/// Inteiro e não decimal de propósito: a regra é "a soma do grupo dá 100",
/// e com ponto flutuante essa conferência falharia por arredondamento.
/// Uma linha por critério; critério sem linha usa o peso padrão do catálogo,
/// então a tabela vazia equivale à configuração original da planilha.
model PesoCriterio {
  criterio  String   @id
  peso      Int
  updatedAt DateTime @updatedAt
}

/// Status de um WIN numa semana. A planilha usa FEITO / NÃO FEITO / EM
/// ANDAMENTO e deixa a célula **vazia** com frequência — vazio vira PENDENTE
/// aqui, para que "ninguém preencheu" seja um estado nomeado e não um buraco.
/// O que aconteceu com uma aparição do WIN numa semana.
enum DesfechoWin {
  /// Está no card desta semana, ocupando uma das três posições.
  NO_CARD
  /// Virou item do plano de ação pela regra das 3 semanas.
  PROMOVIDO
  /// Terminou aqui — concluído ou abandonado, conforme o `status`.
  ENCERRADO
}

enum StatusWin {
  PENDENTE
  EM_ANDAMENTO
  FEITO
  NAO_FEITO
}

/// Pessoa dona de um Card WIN.
///
/// `nome` é a mesma grafia usada em `Projeto.responsavel`: é ele que será
/// gravado lá quando um WIN virar item do plano de ação, e é o que mantém o
/// relatório "por responsável" do dashboard somando certo. Por isso é único —
/// a lista fechada existe justamente para "Fabiano Garcia" e "Fabiano" não
/// virarem duas pessoas.
///
/// `clerkUserId` é opcional de propósito: um colaborador pode ter card antes
/// de ter conta, e a aba Referências da planilha já listava quatro pessoas.
model Colaborador {
  id          String  @id @default(cuid())
  nome        String  @unique
  clerkUserId String? @unique
  /// Área da GIA — AGP, APD ou ACT. Serve de padrão ao abrir um card novo.
  area        String?
  /// E-mail para notificações. Semeado pelo Clerk no vínculo da conta e
  /// editável em /colaboradores — quem veio da planilha nunca fez login.
  email       String?
  ativo       Boolean @default(true)
  /// Pode excluir projeto, editar os pesos da matriz e gerenciar colaboradores.
  /// Enquanto NINGUÉM for administrador, todos podem (o comportamento de antes
  /// desta coluna) — assim o sistema não nasce trancado. Ver `administracao.ts`.
  administrador Boolean @default(false)
  /// Perfil Leitor: vê tudo e exporta, mas não grava nada. O padrão (false) é o
  /// Colaborador, que edita. Administrador nunca é leitor. Ver `administracao.ts`.
  somenteLeitura Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards CardSemanal[]
  wins  Win[]
  acoes Acao[]

  @@index([ativo])
}

/// O Card WIN de um colaborador numa semana — o cabeçalho da aba da planilha.
///
/// Não guarda o bloco "WINs da semana anterior": ele é **derivado** dos
/// registros da semana anterior. Era a duplicação manual desse bloco que fazia
/// a planilha divergir de si mesma (a aba S37 repetia o bloco da S36 em vez de
/// trazer os WINs atuais dela).
model CardSemanal {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  /// Ano e semana do calendário da CTCEA (ver `semana-ctcea.ts`) — NÃO é ISO.
  ano    Int
  semana Int

  area         String?
  atividade    String?
  alertaRiscos String?
  pedidoAjuda  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registros WinSemana[]

  @@unique([colaboradorId, ano, semana])
  @@index([ano, semana])
}

/// O compromisso em si, com identidade que **atravessa semanas**.
///
/// É esta identidade que permite contar repetições sem comparar texto. Na
/// planilha o mesmo item aparecia como "… relatórios orçamentários", depois
/// "… relatórios orçamentários ()" e depois "… relatórios orçamentários () -
/// SGO": qualquer contagem por string erraria.
model Win {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  descricao String
  suporte   String?

  /// Aparições que existiram fora do sistema, semeadas na importação da
  /// planilha. Sem isto, um WIN que já vinha de três semanas recomeçaria do
  /// zero e escaparia da promoção justamente no momento em que ela é devida.
  aparicoesAnteriores Int @default(0)

  /// Preenchidos quando o WIN é promovido ao plano de ação. Exatamente um dos
  /// dois fica preenchido — projeto novo ou ação dentro de projeto existente.
  promovidoEm DateTime?
  projetoId   String?
  projeto     Projeto?  @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  acaoId      String?
  acao        Acao?     @relation(fields: [acaoId], references: [id], onDelete: SetNull)

  /// Encerrado sem promoção (concluído ou abandonado).
  encerradoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registros WinSemana[]

  @@index([colaboradorId])
  @@index([promovidoEm])
}

/// A aparição de um WIN numa semana: prazo, status e posição no card.
model WinSemana {
  id     String      @id @default(cuid())
  winId  String
  win    Win         @relation(fields: [winId], references: [id], onDelete: Cascade)
  cardId String
  card   CardSemanal @relation(fields: [cardId], references: [id], onDelete: Cascade)

  /// 1 a 3 — o limite do método, garantido também no banco pela CHECK
  /// `WinSemana_ordem_entre_1_e_3`.
  ordem  Int
  /// O que aconteceu com esta APARIÇÃO — e não com o WIN.
  ///
  /// Mora aqui, e não em `Win`, porque um WIN promovido na semana 39 continua
  /// tendo acontecido nas semanas 37 e 38: ler o desfecho de `Win.promovidoEm`
  /// tiraria o WIN do denominador de todas as semanas anteriores.
  desfecho DesfechoWin @default(NO_CARD)
  prazo  DateTime?
  status StatusWin @default(PENDENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A unicidade de `[cardId, ordem]` é **parcial** e vive em SQL, na migration
  /// `wins_desfecho_da_aparicao`: vale só onde `desfecho = NO_CARD`. É o que
  /// libera a vaga quando um WIN sai do card sem apagar o histórico dele. O
  /// Prisma não expressa índice parcial — mesmo caminho da CHECK de `ordem`.
  /// O mesmo WIN não aparece duas vezes no mesmo card.
  @@unique([cardId, winId])
  @@index([winId])
  @@index([desfecho])
}

/// Falhas do sistema, guardadas para consulta pelo administrador.
///
/// Existe porque o log de execução da Vercel (plano Hobby) guarda só 1 hora: um
/// erro de sexta à noite já terá sumido na segunda. Só produção grava, e o que
/// passa de 30 dias é apagado.
model RegistroErro {
  id       String   @id @default(cuid())
  criadoEm DateTime @default(now())
  /// De onde veio: "Falha ao salvar WIN", "Resend recusou o e-mail", "Erro em /dashboards".
  origem   String
  mensagem String
  /// Pilha ou corpo da resposta, truncado.
  detalhe  String?
  rota     String?
  /// Identificador que o Next mostra ao usuário na tela de erro.
  digest   String?

  @@index([criadoEm])
}
